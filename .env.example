# Пример конфигурации SMTP для отправки писем с отчётом (Яндекс 360 / корпоративная почта).
# Скопируйте в .env и заполните реальными значениями. Если оставить пустым/не настраивать —
# приложение продолжит работать нормально, письма просто не будут отправляться.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@your-domain.ru
EMAIL_HOST_PASSWORD=app-password-from-yandex
DEFAULT_FROM_EMAIL=noreply@your-domain.ru
EMAIL_TIMEOUT=10
